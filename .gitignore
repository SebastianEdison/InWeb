# Entorno virtual (no es código, se puede recrear)
venv/

# Clave secreta de sesion, generada automaticamente en el primer arranque
secret.key

# Base de datos (datos privados y archivos pesados)
*.db

# Archivos temporales de Python
__pycache__/
*.pyc

# Reportes de prueba (CSV)
*.csv

# Reportes de cierre generados (datos reales del negocio, no codigo)
reportes/*.xlsx

# Artefactos de PyInstaller (se regeneran con build.bat)
build/
dist/

# Logs de la app compilada
logs/

# Cache de pytest
.pytest_cache/